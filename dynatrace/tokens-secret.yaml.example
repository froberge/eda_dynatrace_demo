# Copy to tokens-secret.yaml (gitignored) and replace the token values.
# Secret name must match the DynaKube name (dynakube) unless spec.tokens is set.
#
# Latest Dynatrace platform tokens from My platform tokens (generate for you):
#   apiToken         → Kubernetes Operator scopes (fleet-management:*, settings:objects:read/write)
#   dataIngestToken  → Kubernetes Ingest scopes (openpipeline:*:ingest, storage:metrics:write)
# Account admins can instead assign the tokens to a service user with those policies.
apiVersion: v1
kind: Secret
metadata:
  name: dynakube
  namespace: dynatrace
  labels:
    app.kubernetes.io/part-of: eda-dynatrace-demo
    app.kubernetes.io/component: dynatrace-operator
type: Opaque
stringData:
  apiToken: REPLACE_WITH_OPERATOR_TOKEN
  dataIngestToken: REPLACE_WITH_DATA_INGEST_TOKEN
